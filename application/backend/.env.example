# Copy to .env and fill in. Never commit .env — only this file.
# Every variable here is validated at startup by src/config/env.ts, so a typo
# crashes the process at boot instead of becoming `undefined` on a hot path.

# ---------------------------------------------------------------- app tier
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug

# ---------------------------------------------------------------- data tier
# Reached only from the app subnet. Never expose 5432 — see
# 01-paper-design/traffic-flows.md.
DATABASE_URL=postgresql://taskflow:change-me@localhost:5432/taskflow
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- presentation tier
# Explicit allowlist. A wildcard is rejected at startup by design.
# Production: the real https origin of the frontend.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------------------------------------------------------------- auth
# Generate each with: openssl rand -base64 48
# They must differ, and must not look like a placeholder, or production boot fails.
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-output
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# ---------------------------------------------------------------- limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------- proxy
# Set true behind Application Gateway or an ingress. The value is the number of
# trusted hops, not a boolean wildcard — `true` would let any client spoof
# X-Forwarded-For and poison the rate limiter.
TRUST_PROXY=false
